# =========================
# Secrets & Configuration
# =========================
# NEVER upload API keys or database credentials
app/config/secrets.jason
app/config/
app/config/*
.env

# =========================
# Databases & Local Data
# =========================
# Ignore the live offline databases to prevent merge conflicts and data leaks
# The .keep file ensures the empty 'db' folder is still copied to new PCs
*.sqlite
*.sqlite3

# =========================
# Heavy Assets & Media
# =========================
# Ignore downloaded attendee photos (keeps the repo lightweight)
app/attendee_photos/*
!app/attendee_photos/.keep

# =========================
# Generated Files
# =========================
# Ignore application and error logs
app/logs/*
!app/logs/.keep
*.log

# =========================
# Python Environment
# =========================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
Pipfile.lock


# =========================
# OS Specific Files
# =========================
.DS_Store
Thumbs.db