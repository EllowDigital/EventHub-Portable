# =========================
# Secrets & Configuration
# =========================
# NEVER upload API keys or database credentials
app/config/secrets.json
.env

# =========================
# Databases & Local Data
# =========================
# Ignore the live offline database to prevent merge conflicts and data leaks
app/eventhub_local.db
*.db
*.sqlite
*.sqlite3

# =========================
# Heavy Assets & Media
# =========================
# Ignore downloaded attendee photos (keeps the repo lightweight)
app/attendee_photos/*
!app/attendee_photos/.keep

# =========================
# Generated Files
# =========================
# Ignore automatic backups, exports, and logs
app/backups/*
!app/backups/.keep

app/exports/*
!app/exports/.keep

app/logs/*
!app/logs/.keep
*.log

# =========================
# Python Environment
# =========================
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
Pipfile.lock

# =========================
# OS Specific Files
# =========================
.DS_Store
Thumbs.db